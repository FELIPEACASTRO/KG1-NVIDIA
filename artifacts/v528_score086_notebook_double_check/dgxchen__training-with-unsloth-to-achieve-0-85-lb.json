      "kind": "markdown",
      "text": "## Create submission.zip"
    },
    {
      "cell": 15,
      "line": 1,
      "kind": "code",
      "text": "import json, os, shutil, zipfile"
    },
    {
      "cell": 15,
      "line": 4,
      "kind": "code",
      "text": "SUBMISSION_ADAPTER_DIR = os.path.join(OUTPUT_DIR, \"submission_adapter\")"
    },
    {
      "cell": 15,
      "line": 5,
      "kind": "code",
      "text": "os.makedirs(SUBMISSION_ADAPTER_DIR, exist_ok=True)"
    },
    {
      "cell": 15,
      "line": 7,
      "kind": "code",
      "text": "required_files = [\"adapter_config.json\", \"adapter_model.safetensors\"]"
    },
    {
      "cell": 15,
      "line": 9,
      "kind": "code",
      "text": "if TRAIN_ON_KAGGLE:"
    },
    {
      "cell": 15,
      "line": 10,
      "kind": "code",
      "text": "src_adapter_dir = \"/kaggle/working/sft_adapter\""
    },
    {
      "cell": 15,
      "line": 11,
      "kind": "code",
      "text": "print(\"Packaging freshly trained adapter from:\", src_adapter_dir)"
    },
    {
      "cell": 15,
      "line": 13,
      "kind": "code",
      "text": "src_adapter_dir = PRETRAINED_ADAPTER_DATASET_PATH"
    },
    {
      "cell": 15,
      "line": 14,
      "kind": "code",
      "text": "print(\"Packaging pre-trained adapter directly from:\", src_adapter_dir)"
    },
    {
      "cell": 15,
      "line": 17,
      "kind": "code",
      "text": "src = os.path.join(src_adapter_dir, fname)"
    },
    {
      "cell": 15,
      "line": 18,
      "kind": "code",
      "text": "dst = os.path.join(SUBMISSION_ADAPTER_DIR, fname)"
    },
    {
      "cell": 15,
      "line": 20,
      "kind": "code",
      "text": "raise FileNotFoundError(f\"Missing required adapter file: {src}\")"
    },
    {
      "cell": 15,
      "line": 24,
      "kind": "code",
      "text": "config_path = os.path.join(SUBMISSION_ADAPTER_DIR, \"adapter_config.json\")"
    },
    {
      "cell": 15,
      "line": 25,
      "kind": "code",
      "text": "with open(config_path, \"r\") as f:"
    },
    {
      "cell": 15,
      "line": 30,
      "kind": "code",
      "text": "cfg[\"lora_dropout\"] = 0.0"
    },
    {
      "cell": 15,
      "line": 32,
      "kind": "code",
      "text": "with open(config_path, \"w\") as f:"
    },
    {
      "cell": 15,
      "line": 35,
      "kind": "code",
      "text": "zip_path = os.path.join(OUTPUT_DIR, \"submission.zip\")"
    },
    {
      "cell": 15,
      "line": 36,
      "kind": "code",
      "text": "with zipfile.ZipFile(zip_path, \"w\", zipfile.ZIP_DEFLATED) as zf:"
    },
    {
      "cell": 15,
      "line": 38,
      "kind": "code",
      "text": "fpath = os.path.join(SUBMISSION_ADAPTER_DIR, fname)"
    },
    {
      "cell": 15,
      "line": 42,
      "kind": "code",
      "text": "zip_sz = os.path.getsize(zip_path) / 1024 / 1024"
    },
    {
