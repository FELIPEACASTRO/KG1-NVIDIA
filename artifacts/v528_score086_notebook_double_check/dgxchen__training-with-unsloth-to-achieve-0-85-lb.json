    {
      "cell": 10,
      "line": 1,
      "kind": "markdown",
      "text": "## Mode A: Train on Kaggle"
    },
    {
      "cell": 11,
      "line": 1,
      "kind": "code",
      "text": "if TRAIN_ON_KAGGLE:"
    },
    {
      "cell": 11,
      "line": 5,
      "kind": "code",
      "text": "from datasets import Dataset as HFDataset"
    },
    {
      "cell": 11,
      "line": 6,
      "kind": "code",
      "text": "from trl import SFTTrainer, SFTConfig"
    },
    {
      "cell": 11,
      "line": 9,
      "kind": "code",
      "text": "PROMPT_SUFFIX = '\\nPlease put your final answer inside `\\\\boxed{}`. For example: `\\\\boxed{your answer}`'"
    },
    {
      "cell": 11,
      "line": 12,
      "kind": "code",
      "text": "DATASET_PATH = \"/kaggle/input/datasets/dgxchen/nemotron-cot-tong/problem_ids_matched.csv\""
    },
    {
      "cell": 11,
      "line": 13,
      "kind": "code",
      "text": "df = pd.read_csv(DATASET_PATH)"
    },
    {
      "cell": 11,
      "line": 14,
      "kind": "code",
      "text": "print(f\"Full dataset: {len(df)} rows\")"
    },
    {
      "cell": 11,
      "line": 17,
      "kind": "code",
      "text": "train_df = df.sample(frac=1, random_state=SEED).reset_index(drop=True)"
    },
    {
      "cell": 11,
      "line": 18,
      "kind": "code",
      "text": "print(f\"Full dataset: {len(df)} rows\")"
    },
    {
      "cell": 11,
      "line": 27,
      "kind": "code",
      "text": "for _, row in train_df.iterrows():"
    },
    {
      "cell": 11,
      "line": 30,
      "kind": "code",
      "text": "cot = str(row[\"generated_cot\"])"
    },
    {
      "cell": 11,
      "line": 31,
      "kind": "code",
      "text": "if not cot or cot == \"nan\" or len(cot.strip()) < 5:"
    },
    {
      "cell": 11,
      "line": 33,
      "kind": "code",
      "text": "cot_cleaned = re.sub(r'\\\\boxed\\{[^}]*\\}', '', cot).rstrip()"
    },
    {
      "cell": 11,
      "line": 35,
      "kind": "code",
      "text": "assistant_content = cot_cleaned + f\"\\n</think>\\n\\\\boxed{{{answer}}}\""
    },
    {
      "cell": 11,
      "line": 41,
      "kind": "code",
      "text": "dataset = HFDataset.from_list(records)"
    },
    {
      "cell": 11,
      "line": 70,
      "kind": "code",
      "text": "training_args = SFTConfig("
    },
    {
      "cell": 11,
      "line": 72,
      "kind": "code",
      "text": "num_train_epochs=1,"
    },
    {
      "cell": 11,
      "line": 73,
      "kind": "code",
      "text": "per_device_train_batch_size=1,"
    },
    {
      "cell": 11,
      "line": 132,
      "kind": "code",
      "text": "class StratifiedSFTTrainer(SFTTrainer):"
    },
    {
      "cell": 11,
      "line": 137,
      "kind": "code",
      "text": "def get_train_dataloader(self):"
    },
    {
      "cell": 11,
      "line": 138,
      "kind": "code",
      "text": "if self.train_dataset is None:"
    },
    {
      "cell": 11,
      "line": 139,
      "kind": "code",
      "text": "raise ValueError(\"Trainer requires a train_dataset.\")"
    },
    {
      "cell": 11,
      "line": 141,
      "kind": "code",
      "text": "return super().get_train_dataloader()"
    },
    {
      "cell": 11,
      "line": 142,
      "kind": "code",
      "text": "if len(self.stratified_order) != len(self.train_dataset):"
    },
    {
      "cell": 11,
      "line": 143,
      "kind": "code",
      "text": "raise ValueError(\"Stratified order length does not match train dataset\")"
    },
    {
      "cell": 11,
      "line": 146,
      "kind": "code",
      "text": "\"batch_size\": self.args.per_device_train_batch_size,"
    },
    {
      "cell": 11,
      "line": 157,
      "kind": "code",
      "text": "return DataLoader(self.train_dataset, **dataloader_kwargs)"
    },
    {
      "cell": 11,
      "line": 161,
      "kind": "code",
      "text": "training_args.per_device_train_batch_size * training_args.gradient_accumulation_steps,"
    },
    {
      "cell": 11,
      "line": 167,
      "kind": "code",
      "text": "trainer = StratifiedSFTTrainer("
    },
    {
      "cell": 11,
      "line": 169,
      "kind": "code",
      "text": "args=training_args,"
    },
    {
      "cell": 11,
      "line": 170,
      "kind": "code",
      "text": "train_dataset=dataset,"
    },
    {
      "cell": 11,
      "line": 176,
      "kind": "code",
      "text": "print(\"Starting SFT training...\")"
    },
    {
      "cell": 11,
      "line": 178,
      "kind": "code",
      "text": "trainer.train()"
    },
    {
      "cell": 11,
      "line": 180,
      "kind": "code",
      "text": "print(f\"Training done in {elapsed/60:.1f} min\")"
    },
    {
      "cell": 11,
      "line": 183,
      "kind": "code",
      "text": "ADAPTER_DIR = \"/kaggle/working/sft_adapter\""
    },
    {
      "cell": 11,
      "line": 184,
