      "kind": "code",
      "text": "sys.stderr.reconfigure(encoding=\"utf-8\", errors=\"strict\")"
    },
    {
      "cell": 2,
      "line": 12,
      "kind": "code",
      "text": "# Mode A: Train LoRA from scratch on Kaggle GPU"
    },
    {
      "cell": 2,
      "line": 13,
      "kind": "code",
      "text": "TRAIN_ON_KAGGLE = 1"
