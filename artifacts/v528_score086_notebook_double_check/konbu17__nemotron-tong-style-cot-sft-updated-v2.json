      "kind": "code",
      "text": "c = re.sub(r'\\\\boxed\\{[^}]*\\}', '', cot).strip()"
    },
    {
      "cell": 13,
      "line": 165,
      "kind": "code",
      "text": "assistant = f\"{c}\\n</think>\\n\\\\boxed{{{answer}}}\""
