    {
      "cell": 0,
      "line": 1,
      "kind": "markdown",
      "text": "# Adapter Packaging Workflow"
    },
    {
      "cell": 0,
      "line": 4,
      "kind": "markdown",
      "text": "This notebook packages the selected Nemotron adapter checkpoint for submission. I keep a few candidate model variants available, then switch `model_name` to choose the final adapter folder."
    },
    {
      "cell": 0,
      "line": 6,
      "kind": "markdown",
      "text": "The output is written to `/kaggle/working/submission.zip` and includes the adapter weights plus config needed by the competition evaluator."
    },
    {
      "cell": 1,
      "line": 4,
      "kind": "code",
      "text": "\"tinker-adapter\": \"/kaggle/input/models/kienngx/nemotron-nano-30b-trained/triton/tinker-adapter/1\","
    },
    {
      "cell": 1,
      "line": 5,
      "kind": "code",
      "text": "\"5e-5\": \"/kaggle/input/models/kienngx/nemotron-nano-30b-trained/triton/5e-5/1\","
    },
    {
      "cell": 1,
      "line": 6,
      "kind": "code",
      "text": "\"1e-5\": \"/kaggle/input/models/kienngx/nemotron-nano-30b-trained/triton/1e-5/1\""
    },
    {
      "cell": 1,
      "line": 9,
      "kind": "code",
      "text": "model_name = \"tinker-adapter\""
    },
    {
      "cell": 1,
      "line": 12,
      "kind": "code",
      "text": "submit_dir = \"/kaggle/working/submission\""
    },
    {
      "cell": 1,
      "line": 15,
      "kind": "code",
      "text": "shutil.copy(f\"{source_path}/adapter_model.safetensors\", submit_dir)"
    },
    {
      "cell": 1,
      "line": 16,
      "kind": "code",
      "text": "shutil.copy(f\"{source_path}/adapter_config.json\", submit_dir)"
    },
    {
      "cell": 1,
      "line": 17,
      "kind": "code",
      "text": "shutil.make_archive(\"/kaggle/working/submission\", \"zip\", submit_dir)"
    }
  ]
