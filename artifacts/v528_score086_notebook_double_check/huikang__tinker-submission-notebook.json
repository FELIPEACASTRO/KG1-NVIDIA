    {
      "cell": 34,
      "line": 97,
      "kind": "code",
      "text": "# Search for boxed answer"
    },
    {
      "cell": 34,
      "line": 98,
      "kind": "code",
      "text": "# Match all instances of \\boxed{...} or unclosed \\boxed{ at the end"
    },
    {
      "cell": 34,
      "line": 99,
      "kind": "code",
      "text": "matches = re.findall(r\"\\\\boxed\\{([^}]*)(?:\\}|$)\", text)"
