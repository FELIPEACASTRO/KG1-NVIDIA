    {
      "cell": 34,
      "line": 81,
      "kind": "code",
      "text": "Prioritizes extracting answers inside `\\boxed{}`."
    },
    {
      "cell": 34,
      "line": 82,
      "kind": "code",
      "text": "If no `\\boxed{}` format is found, attempts to extract numbers from other formats."
